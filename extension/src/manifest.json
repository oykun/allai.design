{
  "manifest_version": 3,
  "name": "allai",
  "version": "1.0.0",
  "description": "Right-click an image, a post or a page, choose Add to AllAI, and it lands in your allai.design inbox with one line on what you like.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["form.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Add to AllAI"
  },
  "options_ui": {
    "page": "options.html"
  }
}
