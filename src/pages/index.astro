---
import { getPublishedItems, getUniqueMulti } from '../lib/items.js';
import Card from '../components/Card.astro';
import SideNav from '../components/SideNav.astro';
import '../styles/global.css';

const items = getPublishedItems();
// Fixed taxonomy — the categories are curated, not derived from the data,
// so the nav order stays stable regardless of what's currently published.
const categories = [
  'Website Design',
  'Product Design',
  'Brand Design',
  'Illustration',
  'Tools',
  'Reading',
];
// Style is the one combined facet — the old Type and Tags values were folded into it.
const styles = getUniqueMulti(items, 'style');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>allai.design — AI design, curated</title>
  <meta name="description" content="Curated AI product UI, design patterns, and tools for designers building with AI." />
  <meta property="og:title" content="allai.design" />
  <meta property="og:description" content="Curated AI product UI, design patterns, and tools for designers building with AI." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://allai.design" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

  <aside class="side-panel side-panel--drawer" id="filters" aria-label="Filters">
    <div class="side-panel-inner">

      <SideNav active="feed" />

      <div class="side-section">
        <div class="filter-group-label">Category</div>
        <ul class="filter-list">
          <li><button class="filter-opt active" data-group="category" data-value="all"><span class="filter-dot"></span>All</button></li>
          {categories.map(c => (
            <li><button class="filter-opt" data-group="category" data-value={c}><span class="filter-dot"></span>{c}</button></li>
          ))}
        </ul>
      </div>

      {styles.length > 0 && (
        <div class="side-section">
          <div class="filter-group-header">
            <button type="button" id="style-clear" class="filter-clear" hidden>Clear</button>
            <span class="filter-group-label">Style</span>
          </div>
          <ul class="filter-list">
            <li><button class="filter-opt active" data-group="style" data-value="all"><span class="filter-dot"></span>All</button></li>
            {styles.map(s => (
              <li><button class="filter-opt" data-group="style" data-value={s}><span class="filter-dot"></span>{s}</button></li>
            ))}
          </ul>
        </div>
      )}

      <div class="side-section side-count">
        <span id="count">{items.length} items</span>
      </div>

    </div>
  </aside>

  <!-- A small globe: a blur over the feed with how many posts are showing
       on one side and "AI" on the other, travelling round it. Drawn on a canvas
       (see the Globe script). Open, a cross takes the centre; with filters on,
       their count sits on the rim. -->
  <button type="button" class="filters-toggle" id="filters-toggle" aria-controls="filters" aria-expanded="false" aria-label={`Filters, ${items.length} posts`}>
    <canvas class="globe" id="globe" aria-hidden="true"></canvas>
    <span id="filters-total" hidden>{items.length}</span>
    <span class="close" aria-hidden="true"><i></i><i></i></span>
    <span class="filters-toggle-count" id="filters-count" hidden></span>
  </button>

  <main id="grid-container">
    {items.length > 0 ? (
      <div class="grid" id="grid">
        {items.map((item, i) => (
          <Card item={item} index={i} />
        ))}
      </div>
    ) : (
      <div class="empty-state">Nothing published yet.</div>
    )}
  </main>

  <div class="modal" id="modal" hidden role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-backdrop" data-modal-close></div>

    <!-- The visual, centred and sized to the stage by the script. -->
    <div class="modal-stage">
      <div class="modal-media"></div>
    </div>

    <button type="button" class="modal-nav modal-nav--prev" aria-label="Previous post">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <button type="button" class="modal-nav modal-nav--next" aria-label="Next post">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
    </button>

    <aside class="modal-details">
      <div class="modal-head">
        <h2 class="modal-title" id="modal-title"></h2>
        <span class="modal-sub"></span>
      </div>
      <p class="modal-note"></p>
      <div class="modal-actions">
        <span class="modal-tags"></span>
        <button type="button" class="modal-info" aria-expanded="false">Info</button>
        <a class="modal-source" target="_blank" rel="noopener noreferrer">Source</a>
        <button type="button" class="modal-close" data-modal-close>Close</button>
      </div>
    </aside>
  </div>

</body>
</html>

<style>
body {
  margin: 0;
  overflow-x: hidden;
}

#grid-container {
  width: 100vw;
}

/* The feed has the whole screen; the filters wait behind the button. */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 2.5rem;
  padding: 2.5rem;
  align-items: start;
}

/* Filter sections */
.filter-group-label {
  color: var(--text-muted);
  margin-bottom: 6px;
}

/* Group heading row — "Clear" sits to the left of the label, right-aligned
   with it, and only appears once the group has a selection. */
.filter-group-header {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8px;
}

.filter-clear {
  font-size: inherit;
  font-family: var(--font);
  color: var(--text-muted);
  background: none;
  border: none;
  padding: 0;
  margin-bottom: 6px;
  cursor: pointer;
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.1s;
}

.filter-clear:hover { color: var(--text-primary); }
.filter-clear[hidden] { display: none; }

.filter-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.filter-opt {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 7px;
  font-size: inherit;
  font-family: var(--font);
  color: var(--text-muted);
  background: none;
  border: none;
  cursor: pointer;
  padding: 2px 0;
  width: 100%;
  text-align: right;
  line-height: 1.4;
  transition: color 0.1s;
}

.filter-opt:hover { color: var(--text-primary); }
.filter-opt:hover .filter-dot { border-color: var(--text-primary); }

.filter-opt.active {
  color: var(--text-primary);
  font-weight: 500;
}

.filter-opt.active .filter-dot {
  background: var(--text-primary);
  border-color: var(--text-primary);
}

.filter-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: 1.5px solid var(--text-muted);
  flex-shrink: 0;
  order: 1; /* dot after text (right side) */
  transition: all 0.1s;
}

/* Style takes several values at once, so its markers are square — checkboxes
   against Category's round, pick-one radios. */
.filter-opt[data-group="style"] .filter-dot {
  border-radius: 1px;
  width: 7px;
  height: 7px;
}

.filters-toggle {
  position: fixed;
  left: 50%;
  bottom: 24px;
  z-index: 150;
  width: 72px;
  margin-left: -36px; /* centred without transform, which the hover scale uses */
  height: 72px;
  padding: 0;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  /* No colour of its own: just the feed behind it, blurred, lifted by a soft
     shadow so it doesn't vanish on white. */
  background: rgba(255, 255, 255, 0.01);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  box-shadow:
    0 10px 30px rgba(17, 17, 16, 0.16),
    0 2px 6px rgba(17, 17, 16, 0.08);
  transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
}

.filters-toggle:hover { transform: scale(1.06); }
.filters-toggle:active { transform: scale(0.96); }

.globe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: opacity 0.2s;
}

.filters-toggle[aria-expanded="true"] .globe { opacity: 0.25; }

/* Open: a cross on a dark disc takes the centre. */
.close {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30px;
  height: 30px;
  margin: -15px 0 0 -15px;
  border-radius: 50%;
  background: var(--text-primary);
  opacity: 0;
  transform: rotate(-90deg) scale(0.5);
  transition: opacity 0.2s, transform 0.3s cubic-bezier(0.2, 0, 0, 1);
}

.close i {
  position: absolute;
  left: 8px;
  right: 8px;
  top: 14px;
  height: 2px;
  border-radius: 999px;
  background: #fff;
  transform: rotate(45deg);
}

.close i + i { transform: rotate(-45deg); }

.filters-toggle[aria-expanded="true"] .close { opacity: 1; transform: none; }

/* How many filters are on, as a badge on the rim. */
.filters-toggle-count {
  position: absolute;
  top: -2px;
  right: -2px;
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 999px;
  background: var(--text-primary);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  line-height: 22px;
  text-align: center;
  box-shadow: 0 0 0 2px #fff;
}

.filters-toggle-count[hidden] { display: none; }

@media (prefers-reduced-motion: reduce) {
  .filters-toggle,
  .close { transition: none; }
}

@media (max-width: 720px) {
  .grid { gap: 1.5rem; padding: 1.5rem 1rem; }
  .filters-toggle { bottom: 16px; width: 64px; height: 64px; margin-left: -32px; }
}

</style>

<script>
  // Force-autoplay every video, no interaction required. The autoplay attribute
  // alone is enough in most browsers, but some (Brave, locked-down Firefox,
  // certain embedded webviews) silently ignore it. Setting `muted` as a JS
  // property (not just the HTML attribute) and calling play() explicitly is
  // the reliable cross-browser way to guarantee it actually starts.
  function forcePlay(video: HTMLVideoElement) {
    video.muted = true;
    video.playsInline = true;
    const attempt = () => video.play().catch(() => {
      // Autoplay can still be rejected in rare cases (e.g. data-saver mode).
      // Retry once on next paint rather than leaving it stuck on the poster.
      requestAnimationFrame(() => video.play().catch(() => {}));
    });
    if (video.readyState >= 2) attempt();
    else video.addEventListener('loadeddata', attempt, { once: true });
  }

  document.querySelectorAll('video').forEach(v => forcePlay(v as HTMLVideoElement));

  const cards = document.querySelectorAll('.card');
  const count = document.getElementById('count');

  // Category is single-select. Style is multi-select: picking several styles
  // widens the result (an item matching any of them shows), which is how
  // faceted filters conventionally behave within one group.
  let activeCategory = 'all';
  const activeStyles = new Set<string>();

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const el = card as HTMLElement;
      const cardStyles = (el.dataset.style || '').split(',').filter(Boolean);
      const matches =
        (activeCategory === 'all' || el.dataset.category === activeCategory) &&
        (activeStyles.size === 0 || cardStyles.some(s => activeStyles.has(s)));
      el.style.display = matches ? '' : 'none';
      if (matches) {
        visible++;
        const video = el.querySelector('video');
        if (video) forcePlay(video as HTMLVideoElement);
      }
    });
    count!.textContent = `${visible} items`;
    filtersTotal!.textContent = String(visible);
    filtersToggle.setAttribute('aria-label', `Filters, ${visible} posts`);
    const active = (activeCategory === 'all' ? 0 : 1) + activeStyles.size;
    filtersCount!.hidden = active === 0;
    filtersCount!.textContent = String(active);
    layout();
  }

  // ---- Globe --------------------------------------------------------------
  // The Filters button: the post count and "AI" on opposite sides of a sphere,
  // letter by letter round a slightly tilted equator, turning. Each letter is
  // squeezed by the cosine of its angle, so words bend round the edge and
  // vanish behind as the other comes round. One still frame for reduced motion.

  const globe = document.getElementById('globe') as HTMLCanvasElement | null;
  if (globe) {
    const ctx = globe.getContext('2d')!;
    const FONT = '800 30px Geist, sans-serif';
    const TRACKING = -2; // px between letters: tight
    const TILT = -12 * Math.PI / 180;
    const TURN_MS = 7000;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let size = 0;

    const fit = () => {
      size = globe.clientWidth;
      const dpr = Math.min(window.devicePixelRatio || 1, 3);
      globe.width = Math.round(size * dpr);
      globe.height = Math.round(size * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    // One word centred on `centre` (radians) round a band of radius `band`.
    const word = (text: string, centre: number, band: number, r: number) => {
      const chars = [...text];
      const widths = chars.map(ch => ctx.measureText(ch).width + TRACKING);
      const total = widths.reduce((a, b) => a + b, 0);
      let at = centre - total / band / 2;
      chars.forEach((ch, i) => {
        const span = widths[i] / band;
        const angle = at + span / 2;
        at += span;
        const depth = Math.cos(angle);
        if (depth <= 0.04) return;
        ctx.save();
        ctx.translate(r, r);
        ctx.rotate(TILT);
        ctx.translate(band * Math.sin(angle), 0);
        ctx.scale(depth, 0.92 + 0.08 * depth);
        ctx.fillText(ch, 0, 0);
        ctx.restore();
      });
    };

    const draw = (t: number) => {
      const r = size / 2;
      ctx.clearRect(0, 0, size, size);
      ctx.font = FONT;
      ctx.fillStyle = '#111110';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      const turn = (t / TURN_MS) * Math.PI * 2;
      const band = r * 0.86;
      word(filtersTotal?.textContent || '', -turn, band, r);
      word('AI', Math.PI - turn, band, r);
    };

    const frame = (t: number) => {
      draw(t);
      requestAnimationFrame(frame);
    };

    document.fonts.load(FONT).finally(() => {
      fit();
      if (still) draw(0);
      else requestAnimationFrame(frame);
      new ResizeObserver(() => { fit(); if (still) draw(0); }).observe(globe);
    });
  }

  // ---- Filters drawer -----------------------------------------------------
  // Hidden until the button at the bottom right opens it; the button, Esc or a
  // click anywhere else closes it again. The button shows how many filters are on.

  const filters = document.getElementById('filters')!;
  const filtersToggle = document.getElementById('filters-toggle')!;
  const filtersCount = document.getElementById('filters-count');
  const filtersTotal = document.getElementById('filters-total');

  // Chips pop in from the bottom up, nearest the button first.
  const chips = [...filters.querySelectorAll('.site-logo, .nav-link, .filter-group-label, .filter-clear, .filter-opt, .side-count span')] as HTMLElement[];
  chips.forEach((chip, i) => chip.style.setProperty('--n', String(chips.length - 1 - i)));

  function setFiltersOpen(open: boolean) {
    filters.classList.toggle('open', open);
    filtersToggle.setAttribute('aria-expanded', String(open));
  }

  filtersToggle.addEventListener('click', () => setFiltersOpen(!filters.classList.contains('open')));
  document.addEventListener('click', e => {
    const t = e.target as Node;
    if (filters.classList.contains('open') && !filters.contains(t) && !filtersToggle.contains(t)) setFiltersOpen(false);
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modal.hidden && filters.classList.contains('open')) setFiltersOpen(false);
  });

  // ---- Masonry ------------------------------------------------------------
  // Columns as wide as the grid's own (min 320px); each visible card, newest
  // first, goes to the shortest column. Cards are positioned, never moved in
  // the DOM, so playing videos keep playing. Any card changing height (an
  // image or video arriving, a resize) lays the grid out again.

  const grid = document.getElementById('grid');
  const MIN_COLUMN = 320;

  function layout() {
    if (!grid) return;
    const cs = getComputedStyle(grid);
    const padLeft = parseFloat(cs.paddingLeft);
    const padTop = parseFloat(cs.paddingTop);
    const gap = parseFloat(cs.columnGap) || 16;
    const inner = grid.clientWidth - padLeft - parseFloat(cs.paddingRight);
    const n = Math.max(1, Math.floor((inner + gap) / (MIN_COLUMN + gap)));
    const width = (inner - gap * (n - 1)) / n;
    const shown = [...cards].filter(c => (c as HTMLElement).style.display !== 'none') as HTMLElement[];

    grid.classList.add('masonry');
    shown.forEach(c => { c.style.width = `${width}px`; });
    const heights = new Array(n).fill(0);
    shown.forEach(c => {
      const col = heights.indexOf(Math.min(...heights));
      c.style.left = `${padLeft + col * (width + gap)}px`;
      c.style.top = `${padTop + heights[col]}px`;
      heights[col] += c.offsetHeight + gap;
    });
    grid.style.height = `${padTop + Math.max(0, Math.max(...heights) - gap) + parseFloat(cs.paddingBottom)}px`;
  }

  let queued = false;
  function scheduleLayout() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; layout(); });
  }

  // Until a picture arrives its card is laid out as 4:3, so the columns don't
  // all collapse to the top and reshuffle once everything has loaded.
  document.querySelectorAll('.card-image img').forEach(node => {
    const img = node as HTMLImageElement;
    if (img.complete && img.naturalWidth) return;
    img.style.aspectRatio = '4 / 3';
    const done = () => { img.style.aspectRatio = ''; };
    img.addEventListener('load', done, { once: true });
    img.addEventListener('error', done, { once: true });
  });

  if (grid) {
    const watch = new ResizeObserver(scheduleLayout);
    watch.observe(grid);
    cards.forEach(c => watch.observe(c));
    layout();
  }

  function syncGroup(group: string, isOn: (value: string) => boolean) {
    document.querySelectorAll(`.filter-opt[data-group="${group}"]`).forEach(b => {
      b.classList.toggle('active', isOn((b as HTMLElement).dataset.value!));
    });
  }

  const styleClear = document.getElementById('style-clear');

  function syncStyleGroup() {
    syncGroup('style', v => v === 'all' ? activeStyles.size === 0 : activeStyles.has(v));
    if (styleClear) styleClear.hidden = activeStyles.size === 0;
  }

  styleClear?.addEventListener('click', () => {
    activeStyles.clear();
    syncStyleGroup();
    applyFilters();
  });

  // ---- Detail modal -------------------------------------------------------

  const modal = document.getElementById('modal')!;
  const modalStage = modal.querySelector('.modal-stage') as HTMLElement;
  const modalTitle = modal.querySelector('.modal-title') as HTMLElement;
  const modalSub = modal.querySelector('.modal-sub') as HTMLElement;
  const modalTags = modal.querySelector('.modal-tags') as HTMLElement;
  const modalNote = modal.querySelector('.modal-note') as HTMLElement;
  const modalMedia = modal.querySelector('.modal-media') as HTMLElement;
  const modalSource = modal.querySelector('.modal-source') as HTMLAnchorElement;
  const modalInfo = modal.querySelector('.modal-info') as HTMLButtonElement;
  const navPrev = modal.querySelector('.modal-nav--prev') as HTMLButtonElement;
  const navNext = modal.querySelector('.modal-nav--next') as HTMLButtonElement;

  let current: HTMLElement | null = null;      // the card on show
  let lastTrigger: HTMLElement | null = null;  // its button, for focus and the close morph
  let openedFromEl: HTMLElement | null = null; // its thumbnail, blanked while the modal shows it

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const narrow = matchMedia('(max-width: 720px)');
  const MAX_UPSCALE = 2; // a small picture grows to fill the screen, but no more than twice its size

  /**
   * FLIP: the modal's media starts sitting exactly on top of the card that was
   * clicked, then animates to the size and position layout already gave it. The
   * card grows into the big view rather than the big view appearing over it.
   */
  function morph(el: HTMLElement, from: DOMRect, reverse = false) {
    const to = el.getBoundingClientRect();
    if (!from.width || !to.width) return null;

    // Measured corner-to-corner, so the transform has to scale from the same
    // corner — with the default centre origin the element drifts off course.
    const start = `translate(${from.left - to.left}px, ${from.top - to.top}px) ` +
                  `scale(${from.width / to.width}, ${from.height / to.height})`;

    const at = (transform: string) => ({ transform, transformOrigin: 'top left' });

    return el.animate(
      reverse ? [at('none'), at(start)] : [at(start), at('none')],
      { duration: reverse ? 260 : 380, easing: 'cubic-bezier(0.2, 0, 0, 1)', fill: 'both' }
    );
  }

  // Waits until the element knows its own size, so `to` is measured against
  // real layout rather than a zero-height box.
  function whenSized(el: HTMLElement, done: () => void) {
    const img = el as HTMLImageElement;
    if (el.tagName === 'IMG') {
      if (img.complete && img.naturalWidth) done();
      else img.addEventListener('load', done, { once: true });
    } else {
      const v = el as HTMLVideoElement;
      if (v.videoWidth) done();
      else v.addEventListener('loadedmetadata', done, { once: true });
    }
  }

  const isStack = () => modalMedia.classList.contains('modal-media--stack');
  const isTall = () => modalMedia.classList.contains('modal-media--tall');

  // A single picture or video, sized to the largest box the stage allows at its
  // own shape. CSS alone can shrink it to fit but never grow it.
  function fitMedia() {
    if (isStack() || isTall()) return;
    const el = modalMedia.firstElementChild as HTMLImageElement | HTMLVideoElement | null;
    if (!el) return;
    const w = (el as HTMLImageElement).naturalWidth || (el as HTMLVideoElement).videoWidth;
    const h = (el as HTMLImageElement).naturalHeight || (el as HTMLVideoElement).videoHeight;
    if (!w || !h) return;
    const box = narrow.matches
      ? { width: innerWidth - 32, height: innerHeight * 0.7 }
      : modalStage.getBoundingClientRect();
    const scale = Math.min(box.width / w, box.height / h, MAX_UPSCALE);
    el.style.width = `${Math.floor(w * scale)}px`;
    el.style.height = `${Math.floor(h * scale)}px`;
    el.style.maxHeight = 'none';
  }

  // The element that flies between card and modal: the media, or for a tall
  // screenshot or a gallery its scrolling box.
  function morphTarget() {
    return isTall() || isStack() ? modalMedia : modalMedia.firstElementChild as HTMLElement;
  }

  const mediaOf = (card: HTMLElement) =>
    card.querySelector('.card-image img, .card-image video') as HTMLElement | null;

  // The posts the arrows move through: the feed as filtered, in feed order.
  const visibleCards = () =>
    ([...document.querySelectorAll('.card')] as HTMLElement[]).filter(c => c.style.display !== 'none');

  // Puts a card's post in the modal: text, media, and which arrows apply.
  function fill(card: HTMLElement) {
    const d = card.dataset;
    current = card;
    lastTrigger = card.querySelector('.card-image');

    modalTitle.textContent = d.title || 'Untitled';
    const date = d.date
      ? new Date(d.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
      : '';
    modalSub.textContent = [d.source, date].filter(Boolean).join(' · ');
    modalTags.textContent = [d.category, ...(d.style || '').split(',')].filter(Boolean).join(' · ');
    modalNote.textContent = d.note || '';
    modalNote.title = d.note || '';
    modalInfo.hidden = !d.note;
    modal.classList.toggle('no-note', !d.note);
    modalSource.hidden = !d.sourceUrl;
    if (d.sourceUrl) modalSource.href = d.sourceUrl;

    // Rebuild the media rather than moving the card's node, so the grid
    // underneath keeps rendering while the modal is open.
    for (const a of modalMedia.getAnimations({ subtree: true })) { a.onfinish = a.oncancel = null; a.cancel(); }
    modalMedia.innerHTML = '';
    const cardMedia = mediaOf(card);
    // A whole-page screenshot (over twice as tall as wide) scrolls in its own box.
    const tall = cardMedia instanceof HTMLImageElement && cardMedia.naturalHeight > cardMedia.naturalWidth * 2;
    const gallery: string[] = d.images ? JSON.parse(d.images) : [];
    modalMedia.classList.toggle('modal-media--tall', !d.video && !gallery.length && tall);
    modalMedia.classList.toggle('modal-media--stack', !d.video && gallery.length > 1);
    modalMedia.scrollTop = 0;
    modalMedia.scrollLeft = 0;
    if (d.video) {
      const v = document.createElement('video');
      v.src = d.video;
      if (d.image) v.poster = d.image;
      v.loop = true;
      v.controls = true;
      modalMedia.append(v);
      forcePlay(v);
    } else if (gallery.length > 1) {
      gallery.forEach((src, i) => {
        const img = document.createElement('img');
        img.src = src;
        img.alt = `${d.title || ''} ${i + 1}`;
        modalMedia.append(img);
      });
    } else if (d.image) {
      const img = document.createElement('img');
      img.src = d.image;
      img.alt = d.title || '';
      modalMedia.append(img);
    }

    const list = visibleCards();
    const i = list.indexOf(card);
    navPrev.disabled = i <= 0;
    navNext.disabled = i >= list.length - 1 && !isStack();

    // Blank the thumbnail while the modal shows it: with both on screen the
    // morph reads as a copy flying out, not the thumbnail itself growing.
    if (openedFromEl) openedFromEl.style.visibility = '';
    openedFromEl = reduceMotion ? null : cardMedia;
    if (openedFromEl) openedFromEl.style.visibility = 'hidden';
  }

  function openModal(card: HTMLElement) {
    const from = mediaOf(card)?.getBoundingClientRect();
    fill(card);
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    (modal.querySelector('.modal-close') as HTMLElement)?.focus();
    wake();

    const target = modalMedia.firstElementChild as HTMLElement | null;
    if (!target) return;
    whenSized(target, () => {
      if (!target.isConnected) return;
      fitMedia();
      if (from && !reduceMotion) morph(morphTarget(), from);
    });
  }

  // A gallery steps picture by picture; false once there's none further that way.
  function stepGallery(dir: 1 | -1) {
    const x = modalMedia.scrollLeft;
    const atEnd = x + modalMedia.clientWidth >= modalMedia.scrollWidth - 4;
    const pics = [...modalMedia.children] as HTMLElement[];
    const to = dir > 0
      ? (atEnd ? undefined : pics.find(p => p.offsetLeft > x + 4))
      : pics.reverse().find(p => p.offsetLeft < x - 4);
    if (!to) return false;
    modalMedia.scrollTo({ left: to.offsetLeft, behavior: reduceMotion ? 'auto' : 'smooth' });
    return true;
  }

  // Next or previous post, without closing.
  function step(dir: 1 | -1) {
    if (!current) return;
    if (isStack() && stepGallery(dir)) return;
    const list = visibleCards();
    const next = list[list.indexOf(current) + dir];
    if (!next) return;
    fill(next);
    // Keep the feed underneath on the same post, so closing shrinks back into it.
    next.scrollIntoView({ block: 'center' });
    const target = modalMedia.firstElementChild as HTMLElement | null;
    if (!target) return;
    whenSized(target, () => {
      if (!target.isConnected) return;
      fitMedia();
      if (!reduceMotion) morphTarget().animate(
        [{ opacity: 0, transform: `translateX(${dir * 32}px)` }, { opacity: 1, transform: 'none' }],
        { duration: 240, easing: 'cubic-bezier(0.2, 0, 0, 1)' }
      );
    });
  }

  function finishClose() {
    modal.hidden = true;
    modal.classList.remove('info-open', 'is-idle');
    modalInfo.setAttribute('aria-expanded', 'false');
    modalMedia.innerHTML = ''; // stops any playing video
    modalMedia.classList.remove('modal-media--tall', 'modal-media--stack');
    // The box outlives the modal, so the close morph's held end state must not.
    for (const a of modalMedia.getAnimations()) { a.onfinish = a.oncancel = null; a.cancel(); }
    document.body.style.overflow = '';
    if (openedFromEl) openedFromEl.style.visibility = '';
    openedFromEl = null;
    lastTrigger?.focus({ preventScroll: true });
    lastTrigger = null;
    current = null;
  }

  function closeModal() {
    const target = modalMedia.firstElementChild ? morphTarget() : null;
    // Shrink back into the card on show — unless a filter has since hidden it.
    const from = openedFromEl && lastTrigger?.offsetParent !== null ? openedFromEl.getBoundingClientRect() : null;
    if (target && from && !reduceMotion) {
      const anim = morph(target, from, true);
      if (anim) {
        anim.onfinish = finishClose;
        anim.oncancel = finishClose;
        return;
      }
    }
    finishClose();
  }

  document.querySelectorAll('.card').forEach(card => {
    const trigger = card.querySelector('.card-image') as HTMLElement | null;
    trigger?.addEventListener('click', () => openModal(card as HTMLElement));
  });

  navPrev.addEventListener('click', () => step(-1));
  navNext.addEventListener('click', () => step(1));

  // A gallery scrolls sideways; let a plain vertical wheel do that too.
  modalMedia.addEventListener('wheel', e => {
    if (!isStack() || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
    modalMedia.scrollLeft += e.deltaY;
    e.preventDefault();
  }, { passive: false });

  // On a phone, a sideways swipe on the visual moves between posts.
  let touchX = 0, touchY = 0;
  modalMedia.addEventListener('touchstart', e => {
    touchX = e.touches[0].clientX;
    touchY = e.touches[0].clientY;
  }, { passive: true });
  modalMedia.addEventListener('touchend', e => {
    if (isStack()) return;
    const dx = e.changedTouches[0].clientX - touchX;
    const dy = e.changedTouches[0].clientY - touchY;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
  });

  modal.querySelectorAll('[data-modal-close]').forEach(el => {
    el.addEventListener('click', closeModal);
  });

  // Title, source and date over the note: the Info button or the i key.
  function toggleInfo(open = !modal.classList.contains('info-open')) {
    modal.classList.toggle('info-open', open);
    modalInfo.setAttribute('aria-expanded', String(open));
  }
  modalInfo.addEventListener('click', () => toggleInfo());

  // Everything but the visual fades soon after the mouse rests.
  const IDLE_MS = 1200;
  let idleTimer = 0;
  function wake() {
    modal.classList.remove('is-idle');
    clearTimeout(idleTimer);
    idleTimer = window.setTimeout(() => {
      if (!modal.hidden && !narrow.matches && !modal.classList.contains('info-open')) {
        modal.classList.add('is-idle');
      }
    }, IDLE_MS);
  }
  modal.addEventListener('mousemove', wake);

  addEventListener('resize', () => { if (!modal.hidden) fitMedia(); });

  document.addEventListener('keydown', e => {
    if (modal.hidden || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'Escape') closeModal();
    else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
    else if (e.key === 'i' || e.key === 'I') toggleInfo();
    wake();
  });

  // ---- Filters ------------------------------------------------------------

  document.querySelectorAll('.filter-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const group = el.dataset.group!;
      const value = el.dataset.value!;

      if (group === 'style') {
        // "All" clears the selection; any other option toggles on and off.
        if (value === 'all') activeStyles.clear();
        else if (activeStyles.has(value)) activeStyles.delete(value);
        else activeStyles.add(value);
        syncStyleGroup();
      } else {
        activeCategory = value;
        syncGroup(group, v => v === value);
      }

      applyFilters();
    });
  });
</script>
