---
const { item } = Astro.props;
const { title, source, category, style, sourceUrl, imageUrl, videoUrl, curationNote, publishedDate } = item;
---

<article
  class="card"
  data-source={source}
  data-category={category}
  data-style={style.join(',')}
  data-title={title}
  data-source-url={sourceUrl}
  data-image={imageUrl}
  data-video={videoUrl}
  data-note={curationNote}
  data-date={publishedDate}
>
  <button type="button" class="card-image" aria-label={`Open details for ${title}`}>
    {videoUrl
      ? <video src={videoUrl} poster={imageUrl || undefined} autoplay muted loop playsinline preload="auto" disablepictureinpicture disableremoteplayback />
      : imageUrl
        ? <img src={imageUrl} alt={title} loading="lazy" />
        : <div class="card-image-placeholder">no image</div>
    }
  </button>
</article>
