---
const { item } = Astro.props;
const { title, source, category, style, sourceUrl, imageUrl, images = [], videoUrl, curationNote, publishedDate } = item;
// A post with several pictures: the card shows the cover, the detail view all of them.
const gallery = !videoUrl && images.length > 1 ? images : [];
---

<article
  class="card"
  data-source={source}
  data-category={category}
  data-style={style.join(',')}
  data-title={title}
  data-source-url={sourceUrl}
  data-image={imageUrl}
  data-images={gallery.length ? JSON.stringify(gallery) : undefined}
  data-video={videoUrl}
  data-note={curationNote}
  data-date={publishedDate}
>
  <button type="button" class="card-image" aria-label={`Open details for ${title}`}>
    {videoUrl
      ? <video src={videoUrl} poster={imageUrl || undefined} autoplay muted loop playsinline preload="auto" disablepictureinpicture disableremoteplayback />
      : imageUrl
        ? <img src={imageUrl} alt={title} loading="lazy" />
        : <div class="card-image-placeholder">no image</div>
    }
    {gallery.length > 0 && <span class="card-count" aria-label={`${gallery.length} images`}>{gallery.length}</span>}
  </button>
</article>
