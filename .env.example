# Cloudflare R2 — media hosting (images + video re-hosted from source CDNs)
# Get these from: Cloudflare dashboard → R2 → Manage API tokens → Create API token
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=allai-design-media
# Public address of the bucket — the r2.dev URL, or a custom domain once attached
# (Cloudflare dashboard → R2 → bucket → Settings → Public Access)
R2_PUBLIC_URL=https://cdn.allai.design

# Optional — where the allai notes live. Comma-separated, ~ allowed.
# Default: ~/Obsidian/Clippings,~/Obsidian/_AI OS/allai
# ALLAI_VAULT_DIRS=

# Optional — where `npm run moodboard` writes. Default: ~/Obsidian/_AI OS/moodboards
# ALLAI_MOODBOARD_DIR=

# Optional — the local receiver for the browser extension (`npm run inbox`).
# Change the port here and in the extension's settings page. Default: 7711
# ALLAI_INBOX_PORT=
# Where captures land. Must sit inside ALLAI_VAULT_DIRS. Default: ~/Obsidian/_AI OS/allai/inbox
# ALLAI_INBOX_DIR=

# Optional — your Apple team id, so extension/build-safari.sh signs the Safari
# extension and Safari keeps it on across restarts. A free Apple ID works:
# Xcode → Settings → Accounts → add it, then its "Personal Team" id.
# ALLAI_APPLE_TEAM=
